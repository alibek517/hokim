{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)manifest.json",
      "destination": "/web/manifest.json"
    },
    {
      "source": "/(.*)sw.js",
      "destination": "/web/sw.js"
    },
    {
      "source": "/(.*)css/(.*)",
      "destination": "/web/css/$2"
    },
    {
      "source": "/(.*)js/(.*)",
      "destination": "/web/js/$2"
    },
    {
      "source": "/(.*)assets/(.*)",
      "destination": "/web/assets/$2"
    },
    {
      "source": "/web/(.*)",
      "destination": "/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/web/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}